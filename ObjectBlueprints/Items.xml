    <object Name="UrsaCascadia_MemorumCrystal" Inherits="Trinket">
        <part Name="Render" DisplayName="{{reminiscent|reminessence}} crystal" Tile="Assets_Content_Textures_Items_bit11" RenderString="&#x4;" ColorString="&amp;B" DetailColor="m" />
        <part Name="Commerce" Value="0" />
