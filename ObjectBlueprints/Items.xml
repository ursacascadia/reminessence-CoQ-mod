        Using this while you carry a reminessence crystal will change the resonance of the existing crystal as well."
        />
        <tag Name="Tier" Value="3" />
        <tag Name="TechTier" Value="4" />
        <part Name="TinkerItem" CanDisassemble="false" CanBuild="false" />
        <part Name="Commerce" Value="650" />
        <tag Name="Gift" Value="*noinherit" />
        <tag Name="ExcludeFromDynamicEncounters" />
